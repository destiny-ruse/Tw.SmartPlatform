<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TwFrameworkVersion Condition="'$(TwFrameworkVersion)' == ''">0.1.0-alpha.1</TwFrameworkVersion>
    <UseRepositoryProjectReferences Condition="'$(UseRepositoryProjectReferences)' == '' and Exists('../../../../../../../BuildingBlocks/src/Gateway/Tw.Gateway/Tw.Gateway.csproj')">true</UseRepositoryProjectReferences>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseRepositoryProjectReferences)' == 'true'">
    <ProjectReference Include="../../../../../../../BuildingBlocks/src/Gateway/Tw.Gateway/Tw.Gateway.csproj" />
    <ProjectReference Include="../../../../../../../BuildingBlocks/src/Gateway/Tw.Gateway.Yarp/Tw.Gateway.Yarp.csproj" />
    <ProjectReference Include="../../../../../../../BuildingBlocks/src/Web/Tw.AspNetCore/Tw.AspNetCore.csproj" />
    <ProjectReference Include="../../../../../../../BuildingBlocks/src/Observability/Tw.Observability/Tw.Observability.csproj" />
    <ProjectReference Include="../../../../../../../BuildingBlocks/src/Configuration/Tw.Configuration/Tw.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseRepositoryProjectReferences)' != 'true' and '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="Tw.Gateway" />
    <PackageReference Include="Tw.Gateway.Yarp" />
    <PackageReference Include="Tw.AspNetCore" />
    <PackageReference Include="Tw.Observability" />
    <PackageReference Include="Tw.Configuration" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseRepositoryProjectReferences)' != 'true' and '$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="Tw.Gateway" Version="$(TwFrameworkVersion)" />
    <PackageReference Include="Tw.Gateway.Yarp" Version="$(TwFrameworkVersion)" />
    <PackageReference Include="Tw.AspNetCore" Version="$(TwFrameworkVersion)" />
    <PackageReference Include="Tw.Observability" Version="$(TwFrameworkVersion)" />
    <PackageReference Include="Tw.Configuration" Version="$(TwFrameworkVersion)" />
  </ItemGroup>
</Project>
