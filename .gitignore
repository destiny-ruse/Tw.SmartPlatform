# Local agent and index state
.superpowers/
.codegraph/
.tw-memory/runtime/

# Local IDE state
.vs/
.vscode/
*.user
*.suo

# Build outputs
bin/
obj/
dist/
build/
coverage/

# Exception: backend/dotnet/Build holds tracked central package-version props,
# not build output. On case-insensitive filesystems the build/ rule above would
# otherwise ignore it.
!backend/dotnet/Build/
!backend/dotnet/Build/**

# Package and language caches
node_modules/
__pycache__/
.pytest_cache/
.temp/

# Local databases and generated search/vector caches
*.sqlite
*.sqlite-*
*.db
*.db-*
*.parquet
*.bin
*.npy
*.npz
